<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaloriMate1.MainPage"
             Title="CalorieMate"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20" BackgroundColor="#F9F9F9">

            <!-- DATE AND TOTAL CALORIES HEADER -->
            <Frame BackgroundColor="White"
       CornerRadius="15"
       Padding="15"
       Margin="0,10"
       HasShadow="True"
       HorizontalOptions="Center"
       WidthRequest="330">

                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                    <!-- Day and Date with arrows -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">

                        <!-- ← Previous Day Button -->
                        <ImageButton Source="leftarrow.png"
                         BackgroundColor="Transparent"
                         WidthRequest="24"
                         HeightRequest="24"
                         Clicked="OnPreviousDayClicked" />

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="dayLabel"
                                           Text="Today"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#1E88E5"
                                           HorizontalOptions="Center" />
                            <Label x:Name="dateLabel"
                                           Text="14 April 2025"
                                           FontSize="14"
                                           TextColor="#1E88E5"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center">
                                           
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDateLabelTapped" />
                                </Label.GestureRecognizers>
                            </Label>



                            <!-- Hidden DatePicker -->
                            <!--<DatePicker x:Name="selectDate"
                            IsVisible="False"
                            DateSelected="onDatePickerSelected"
                            Format="dd/MM/yyyy" /> -->
                        </VerticalStackLayout>

                        <!-- → Next Day Button -->
                        <ImageButton Source="rightarrow.png"
                         BackgroundColor="Transparent"
                         WidthRequest="24"
                         HeightRequest="24"
                         Clicked="OnNextDayClicked" />
                    </HorizontalStackLayout>

                    <!-- Optional: DatePicker for quick jump -->
                    

                    <!-- Calorie Total -->
                    <Label x:Name="totalCaloriesLabel"
               Text="Total Calories: 0 kcal"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#D32F2F"
               HorizontalOptions="Center"
               Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </Frame>





            <!-- FOOD ENTRY SECTION -->
            <Frame CornerRadius="15" BackgroundColor="White" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <!-- Food Name -->
                    <Label Text="🍽️ Food Name" FontAttributes="Bold" FontSize="16" TextColor="#333" />
                    <Entry x:Name="inputFood"
               Placeholder="e.g. Nasi Goreng"
               FontSize="14"
               HeightRequest="45"
               TextColor="Black"
               PlaceholderColor="#999"
               Margin="0,-5,0,0"/>

                    <!-- Calories -->
                    <Label Text="🔥 Calories (kcal)" FontAttributes="Bold" FontSize="16" TextColor="#333" />
                    <Entry x:Name="inputCalories"
               Placeholder="e.g. 400"
               Keyboard="Numeric"
               FontSize="14"
               HeightRequest="45"
               TextColor="Black"
               PlaceholderColor="#999"
               Margin="0,-5,0,0"/>

                    <!-- Meal Time -->
                    <Label Text="🕒 Meal Time" FontAttributes="Bold" FontSize="16" TextColor="#333" />
                    <Frame CornerRadius="12"
               Padding="5"
               BorderColor="#2196F3"
               HasShadow="False"
               HeightRequest="50">
                        <Picker x:Name="mealTimePicker"
                    Title="Select a meal"
                    FontSize="14"
                    TextColor="Black">
                            <Picker.Items>
                                <x:String>🍳 Breakfast</x:String>
                                <x:String>🍱 Lunch</x:String>
                                <x:String>🍝 Dinner</x:String>
                            </Picker.Items>
                        </Picker>
                    </Frame>

                    <FlexLayout Direction="Row" JustifyContent="SpaceBetween">
                        <HorizontalStackLayout Spacing="5">
                            <Image Source="calendaricon.png" WidthRequest="20" HeightRequest="20"/>
                            <Label Text="Date:" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <DatePicker x:Name="selectDate"
                        DateSelected="onDatePickerSelected"
                        Format="dd/MM/yyyy"
                        WidthRequest="130"
                        HeightRequest="45" />
                    </FlexLayout>


                </VerticalStackLayout>
            </Frame>

            <!-- FEEDBACK -->
            <Label x:Name="outputEntry"
               Text="No Entry Yet"
               FontAttributes="Italic"
               TextColor="#888"
               FontSize="14"
               HorizontalOptions="Center"
               Margin="0,10,0,0"/>

            <!-- ACTION BUTTONS -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Add Entry"
                    Clicked="OnAddClicked"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    WidthRequest="110"
                    CornerRadius="12" />

                <Button Text="Reset"
                    Clicked="OnReset"
                    BackgroundColor="#E0E0E0"
                    TextColor="Black"
                    WidthRequest="90"
                    CornerRadius="12" />
            </HorizontalStackLayout>

            <Button x:Name="saveButton"
                Text="Save Record"
                Clicked="OnSaveRecord"
                BackgroundColor="#4CAF50"
                TextColor="White"
                CornerRadius="12"
                Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
