<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaloriMate1.Record"
             Title="Record">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" BackgroundColor="#F9F9F9">

            <!-- Date Selection -->
            <Frame BackgroundColor="White" CornerRadius="12" Padding="10" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="📅 Select Date"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="#333" />
                    <DatePicker x:Name="datePicker"
                            DateSelected="OnDateSelected"
                            Format="dd/MM/yyyy"
                            HorizontalOptions="FillAndExpand" />
                </VerticalStackLayout>
            </Frame>

            <!-- Food Records List -->
            <CollectionView x:Name="recordList"
                        BackgroundColor="Transparent"
                        EmptyView="No records found for this date.">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="10" Padding="15" Margin="0,5" BackgroundColor="White" HasShadow="True">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Food}" FontAttributes="Bold" FontSize="16" TextColor="#222" />
                                    <Label Text="{Binding MealTime, StringFormat='Meal: {0}'}" FontSize="14" TextColor="#666" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="End" Spacing="2">
                                    <Label Text="{Binding Calories, StringFormat='{0} kcal'}" FontAttributes="Bold" FontSize="14" TextColor="#4CAF50" HorizontalTextAlignment="End"/>
                                    <Label Text="{Binding Date}" FontSize="12" TextColor="#999" HorizontalTextAlignment="End"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Total Calories Display -->
            <Label x:Name="totalLabel"
               Text="Total Calories: 0 kcal"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="DarkRed"
               HorizontalOptions="Center"
               Margin="0,20,0,10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>